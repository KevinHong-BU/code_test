<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FastFind</RootNamespace>
    <AssemblyName>FastFind</AssemblyName>
    <Product>빠른 파일 찾기 (FastFind)</Product>
    <Version>1.0.0</Version>

    <!-- DeviceIoControl에 구조체를 넘기기 위한 포인터 사용 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- MFT 직접 읽기에 관리자 권한이 필요하므로 매니페스트에서 권한을 요청합니다 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Malgun Gothic, 9pt</ApplicationDefaultFont>

    <!-- 64비트로 실행해야 큰 색인도 메모리에 여유 있게 올라갑니다 -->
    <PlatformTarget>x64</PlatformTarget>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- Windows 이외의 OS에서 빌드 확인용 (Windows/Visual Studio에서는 영향 없음) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
